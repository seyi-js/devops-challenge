# Application
PORT=3000
NODE_ENV=development
APP_VERSION=1.0.0

# AWS (used by Terraform and AWS CLI — set via `aws configure` or export here for local use)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Deployment (values come from `terraform output` after applying)
EC2_INSTANCE_ID=
ECR_REPOSITORY_URL=
